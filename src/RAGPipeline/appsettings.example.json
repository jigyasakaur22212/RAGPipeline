{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConfiguredDb": "cosmosdb",
  "ChunkSize": "1000",
  "OpenApi": {
    "EmbeddingModelName": "<embedding-model-name>",
    "ApiKey": "<openai-api-key>"
  },
  "CosmosDb": {
    "ConnectionString": "<cosmos-db-connection-string>",
    "DatabaseName": "<database-name>",
    "ContainerName": "<container-name>",
    "PartitionKey": "/<partition-key-property>"
  }
}
